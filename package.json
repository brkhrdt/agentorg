{
  "name": "agent-organization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin": "./src/plugin.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun build --compile ./src/standalone.ts --outfile dist/agentorg",
    "test:binary": "bun run build && ORG_BINARY=./dist/agentorg bun test tests/binary.test.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "8.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
